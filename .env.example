# Copy to apps/web/.env.local and fill in. Never commit real values.

# services/speech base URL (local: uv run uvicorn app.main:app)
SPEECH_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-Speech-Key to services/speech; server-only, same value as the service's SPEECH_SERVICE_KEY
SPEECH_SERVICE_KEY=

# Hosted LLM for answer-content scoring (provider not chosen yet)
LLM_API_KEY=

# Hugging Face Hub token: pull private model weights (Whisper, YOLO .tflite)
HF_TOKEN=

# Supabase project (Dashboard > Project Settings > API Keys). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
