# Copy to apps/web/.env.local and fill in. Never commit real values.

# services/speech base URL (local: uv run uvicorn app.main:app)
SPEECH_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-Speech-Key to services/speech; server-only, same value as the service's SPEECH_SERVICE_KEY
SPEECH_SERVICE_KEY=

# Gemini API key for answer-content scoring: paid tier only, server-only, shared privately
LLM_API_KEY=
# Optional Gemini model id (default gemini-3.5-flash)
LLM_MODEL=

# Hugging Face read token for the private model repo in shared/model-hub.json (pnpm models:pull), shared privately
HF_TOKEN=

# Supabase project (Dashboard > Project Settings > API Keys). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared secret the scheduler sends as Authorization: Bearer <value> to /api/retention; server-only
CRON_SECRET=

# Midtrans Snap (Dashboard > Settings > Access Keys). The server key is server-only; the client key loads Snap.js in the browser.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# true only for real payments; anything else uses the sandbox
MIDTRANS_IS_PRODUCTION=false
