# Copy to apps/web/.env.local and fill in. Never commit real values.

# services/speech base URL (local: uv run uvicorn app.main:app)
SPEECH_SERVICE_URL=http://localhost:8000

# Hosted LLM for answer-content scoring (provider not chosen yet)
LLM_API_KEY=

# Hugging Face Hub token: pull private model weights (Whisper, YOLO .tflite)
HF_TOKEN=

# Database / auth / storage: provider still open (doc section 5)
# DATABASE_URL=
